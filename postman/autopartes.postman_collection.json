{
  "info": {
    "name": "Autopartes FastAPI",
    "description": "Pruebas de la API de compatibilidad de autopartes.\n\nEjecuta la colección completa con el Collection Runner, en orden: cada petición guarda IDs en variables de colección que usan las siguientes. Los datos llevan un sufijo único (`runId`) para poder correrla varias veces, y la carpeta 6 borra lo que creó.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "vehicleId",
      "value": ""
    },
    {
      "key": "vehicleId2",
      "value": ""
    },
    {
      "key": "partId",
      "value": ""
    },
    {
      "key": "partSku",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Sistema",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Genera runId y partSku para esta corrida."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', Date.now().toString());",
                  "pm.collectionVariables.set('partSku', 'QA-' + pm.collectionVariables.get('runId'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
