# Copiar a backend/.env y ajustar. Nunca subir .env al repositorio.
APP_NAME="Autopartes API"
DEBUG=false

DB_HOST=localhost
DB_PORT=3306
DB_USER=autopartes_app
DB_PASSWORD=cambia_esta_clave
DB_NAME=autopartes

# Alternativa: URL completa (tiene prioridad sobre DB_*)
# DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/autopartes?charset=utf8mb4

# Lista JSON de orígenes permitidos (frontend Vite)
CORS_ORIGINS=["http://localhost:5173"]
